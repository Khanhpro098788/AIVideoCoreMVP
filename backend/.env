# ==========================================
# CẤU HÌNH DATABASE (MONGODB)
# ==========================================
# Đường dẫn kết nối tới MongoDB Atlas
MONGO_URI=mongodb+srv://vovankhanh937_db_user:QahIPyBiiGa8t65L@cluster0.ozrzc9i.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Tên Database chính thức của dự án
MONGO_DB_NAME=AIVideoCore_MVP

# ==========================================
# CẤU HÌNH BẢO MẬT & XÁC THỰC (JWT)
# ==========================================
# Chuỗi bí mật dùng để mã hóa Token (Đổi chuỗi này thành 1 chuỗi random ngẫu nhiên bảo mật khi lên Production)
SECRET_KEY=klink_ai_super_secret_key_2026_xyz
# Thuật toán mã hóa JWT
ALGORITHM=HS256
# Thời gian sống của Access Token (15 phút - lưu trên RAM Frontend)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Thời gian sống của Refresh Token (7 ngày - lưu trên HttpOnly Cookie)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CẤU HÌNH HÀNG ĐỢI (REDIS / CELERY)
# ==========================================
# Địa chỉ Redis chạy trên máy ảo hoặc máy local của bạn
REDIS_URL=redis://localhost:6379/0

# ==========================================
# CẤU HÌNH CLOUD STORAGE (S3 / CLOUDINARY)
# ==========================================
# (Phần này sẽ điền sau khi bạn tạo xong tài khoản Cloudinary / AWS S3)
CLOUD_STORAGE_API_KEY=
CLOUD_STORAGE_API_SECRET=
CLOUD_STORAGE_BUCKET_NAME=
